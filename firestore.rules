rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ----------------------------------------------------
    // Sideglance Application Rules
    // ----------------------------------------------------
    match /sideglance/app {
      // User Profiles
      match /users/{userId} {
        // Authenticated users can read profiles to find partners
        allow read: if request.auth != null;
        
        // Allow writing if:
        // 1. The user themselves is modifying their profile
        // 2. Another authenticated user is pairing/unpairing (modifying only the 'partnerUid' field)
        allow write: if request.auth != null && (
          request.auth.uid == userId ||
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['partnerUid']) &&
            (
              // Pairing: Setting partnerUid to request.auth.uid when it was null/unset
              (resource.data.get('partnerUid', null) == null && request.resource.data.get('partnerUid', null) == request.auth.uid) ||
              // Unpairing: Setting partnerUid to null when it was request.auth.uid
              (resource.data.get('partnerUid', null) == request.auth.uid && request.resource.data.get('partnerUid', null) == null)
            )
          )
        );
      }
      
      // User Statuses, Reactions & Chat Messages
      match /statuses/{userId} {
        // Authenticated users can read statuses
        allow read: if request.auth != null;
        
        // Allow writing if:
        // 1. The user is updating their own status
        // 2. The paired partner is adding reactions/messages
        allow write: if request.auth != null && (
          request.auth.uid == userId ||
          get(/databases/$(database)/documents/sideglance/app/users/$(request.auth.uid)).data.partnerUid == userId
        );
      }
    }

    // ----------------------------------------------------
    // Freezer-to-Feast Application Rules
    // ----------------------------------------------------
    match /freezer_to_feast/app {
      // User Profiles
      match /users/{userId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Daily Meals subcollection
      match /users/{userId}/daily_meals/{dateId} {
        allow read, delete: if request.auth != null && request.auth.uid == userId;
        
        allow create, update: if request.auth != null 
                     && request.auth.uid == userId 
                     && dateId.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') 
                     && request.resource.data.timestamp is timestamp;
      }
      
      // Catch-all block for any other subcollections under freezer_to_feast/app/users/{userId}
      match /users/{userId}/{subcollection}/{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId && subcollection != 'daily_meals';
      }
    }
  }
}
