rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Deny read/write by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Match the user profile document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Match the daily_meals subcollection specifically
    match /users/{userId}/daily_meals/{dateId} {
      // Allow read and delete for the authenticated owner
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      
      // Allow create and update only under strict schema validation
      allow create, update: if request.auth != null 
                   && request.auth.uid == userId 
                   && dateId.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') 
                   && request.resource.data.timestamp is timestamp;
    }
    
    // Catch-all block for any other subcollections under users/{userId} (except daily_meals)
    match /users/{userId}/{subcollection}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId && subcollection != 'daily_meals';
    }
  }
}
